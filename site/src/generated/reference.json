{
  "version": "0.1.0",
  "tools": [
    {
      "name": "apps",
      "description": "List the Mac apps that are running and can be controlled. The first line names the app in front. Window titles are shown in brackets: a web app such as \"Workbench\" runs inside \"Google Chrome\", so pass \"Google Chrome\" as the app. To open an app that is not running, call activate with its name; do not use Spotlight.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "activate",
      "description": "Open any installed app by name (for example \"System Settings\", \"Notes\") and bring it to the front. Use this instead of Spotlight, the Dock or Terminal. Typing only works in the frontmost app.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          }
        },
        "required": [
          "app"
        ]
      }
    },
    {
      "name": "outline",
      "description": "List the controls in the app's front window and menu bar: role, name and box. Use it to see what can be clicked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          }
        },
        "required": [
          "app"
        ]
      }
    },
    {
      "name": "act",
      "description": "Click one control in the app: pass its [id] from outline (for example \"e3\"), or describe it in plain words (for example \"the New Document button\"). A small model picks the control and checks the result. It refuses when unsure, and blocks controls that look destructive unless confirm is true. Only set confirm when the user clearly asked for that destructive action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          },
          "agent": {
            "type": "string",
            "description": "Optional id of the agent acting, so parallel agents get their own cursor and take turns."
          },
          "intent": {
            "type": "string",
            "description": "What to click: an id from outline, such as \"e3\", or plain words, such as \"the New Document button\"."
          },
          "confirm": {
            "type": "boolean",
            "description": "Set true only when the user clearly asked for this destructive action. Default false."
          }
        },
        "required": [
          "app",
          "intent"
        ]
      }
    },
    {
      "name": "type",
      "description": "Type text into a text field of the app, by its [id] from outline (fastest) or described in plain words. By default the text replaces everything in the field. To add to one line of a longer text (a note, a document), pass after with text from that line: hand puts the text at the end of that line, checks nothing else changed,. To tick a checklist item afterwards, use check with line. Set mode to \"insert\" to type wherever the cursor already is.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          },
          "agent": {
            "type": "string",
            "description": "Optional id of the agent acting, so parallel agents get their own cursor and take turns."
          },
          "text": {
            "type": "string",
            "description": "The text to type."
          },
          "into": {
            "type": "string",
            "description": "The control: its id from outline, such as \"e3\", or plain words, such as \"the note body\"."
          },
          "after": {
            "type": "string",
            "description": "Text from the line to add to. The new text goes at the end of that line and nothing else changes."
          },
          "mode": {
            "type": "string",
            "enum": [
              "replace",
              "insert"
            ],
            "description": "replace (default) sets the whole field; insert types where the cursor is."
          }
        },
        "required": [
          "app",
          "text",
          "into"
        ]
      }
    },
    {
      "name": "key",
      "description": "Press one key in the frontmost app: return, tab, escape, space, up, down, left, right, delete, or a shortcut like cmd+n or cmd+shift+g. Use it to confirm a name you typed, close a dialog or open a menu command. A shortcut is usually much faster than opening a menu: in Notes, cmd+shift+l starts a checklist and cmd+shift+u checks or unchecks the checklist item the cursor is on; in a browser, cmd+l focuses the address bar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          },
          "key": {
            "type": "string",
            "description": "One key or shortcut: return, tab, escape, space, arrows, delete, or cmd+n, cmd+shift+l and so on."
          }
        },
        "required": [
          "app",
          "key"
        ]
      }
    },
    {
      "name": "steps",
      "description": "Run several actions in a row in one call, when you already know what comes next: for example type into a field, press return, choose a menu item. Each step is one of act, type, key, menu, check or select_text, with the same fields as that tool. Steps that name an [id] skip the model and run at once. It stops at the first step that fails, is refused or is unsure, and returns what happened at every step.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          },
          "agent": {
            "type": "string",
            "description": "Optional id of the agent acting, so parallel agents get their own cursor and take turns."
          },
          "steps": {
            "type": "array",
            "description": "The steps, in order. Each has tool plus the fields that tool takes.",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "enum": [
                    "act",
                    "type",
                    "key",
                    "menu",
                    "check",
                    "select_text"
                  ],
                  "description": "Which tool this step runs."
                },
                "intent": {
                  "type": "string",
                  "description": "What to click: an id from outline, such as \"e3\", or plain words, such as \"the New Document button\"."
                },
                "text": {
                  "type": "string",
                  "description": "The text to type."
                },
                "into": {
                  "type": "string",
                  "description": "The control: its id from outline, such as \"e3\", or plain words, such as \"the note body\"."
                },
                "after": {
                  "type": "string",
                  "description": "Text from the line to add to. The new text goes at the end of that line and nothing else changes."
                },
                "key": {
                  "type": "string",
                  "description": "One key or shortcut: return, tab, escape, space, arrows, delete, or cmd+n, cmd+shift+l and so on."
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Menu path from the menu bar, such as [\"Format\", \"Font\", \"Show Fonts\"]."
                },
                "on": {
                  "type": "boolean",
                  "description": "true to tick or turn on (default), false to untick or turn off."
                },
                "line": {
                  "type": "string",
                  "description": "Text from the checklist line to tick, when into is a text field."
                },
                "from": {
                  "type": "string",
                  "description": "Selection starts at the first place this text appears."
                },
                "through": {
                  "type": "string",
                  "description": "Selection ends at the end of this text. Leave out to select just from."
                }
              },
              "required": [
                "tool"
              ]
            }
          }
        },
        "required": [
          "app",
          "steps"
        ]
      }
    },
    {
      "name": "menu",
      "description": "Choose a command from the app's menu bar by its exact path, for example [\"Format\", \"Checklist\"] or [\"File\", \"New Folder\"]. Faster and safer than clicking through menus. Says so if the item is missing (and lists what is there) or greyed out.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          },
          "agent": {
            "type": "string",
            "description": "Optional id of the agent acting, so parallel agents get their own cursor and take turns."
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Menu path from the menu bar, such as [\"Format\", \"Font\", \"Show Fonts\"]."
          }
        },
        "required": [
          "app",
          "path"
        ]
      }
    },
    {
      "name": "check",
      "description": "Turn a check box or switch on (or off with on=false). Reads it first and does nothing if it is already right, then reads it back. Use this instead of act for check boxes so a second call never flips it back. For a checklist item inside a text (a Notes checklist), pass the text field as into and line with text from that item: hand ticks that line and reads it back.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          },
          "agent": {
            "type": "string",
            "description": "Optional id of the agent acting, so parallel agents get their own cursor and take turns."
          },
          "into": {
            "type": "string",
            "description": "The control: its id from outline, such as \"e3\", or plain words, such as \"the note body\"."
          },
          "on": {
            "type": "boolean",
            "description": "true to tick or turn on (default), false to untick or turn off."
          },
          "line": {
            "type": "string",
            "description": "Text from the checklist line to tick, when into is a text field."
          }
        },
        "required": [
          "app",
          "into"
        ]
      }
    },
    {
      "name": "select_text",
      "description": "Select text inside a text field, from the first occurrence of \"from\" through the end of \"through\" (or just \"from\"). Use it before a menu command that works on the selection, for example select two lines then menu [\"Format\", \"Checklist\"].",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          },
          "agent": {
            "type": "string",
            "description": "Optional id of the agent acting, so parallel agents get their own cursor and take turns."
          },
          "into": {
            "type": "string",
            "description": "The control: its id from outline, such as \"e3\", or plain words, such as \"the note body\"."
          },
          "from": {
            "type": "string",
            "description": "Selection starts at the first place this text appears."
          },
          "through": {
            "type": "string",
            "description": "Selection ends at the end of this text. Leave out to select just from."
          }
        },
        "required": [
          "app",
          "into",
          "from"
        ]
      }
    },
    {
      "name": "expect",
      "description": "Check a control's real state without changing anything: checked, enabled, an exact value, or a value that contains some text. Answers satisfied, unsatisfied or unknown (unknown never means success). Use it to prove a step worked before you call done.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          },
          "into": {
            "type": "string",
            "description": "The control: its id from outline, such as \"e3\", or plain words, such as \"the note body\"."
          },
          "checked": {
            "type": "boolean",
            "description": "Expect the control to be ticked (true) or not (false)."
          },
          "enabled": {
            "type": "boolean",
            "description": "Expect the control to be usable (true) or greyed out (false)."
          },
          "value": {
            "type": "string",
            "description": "Expect exactly this value."
          },
          "contains": {
            "type": "string",
            "description": "Expect the value to contain this text."
          }
        },
        "required": [
          "app",
          "into"
        ]
      }
    },
    {
      "name": "read",
      "description": "Read a text field line by line, by its [id] or plain words. Checklist items show as [ ] (unticked) or [x] (ticked), read from the app itself, so use this, not look, to see whether lines are a checklist or ticked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "description": "Exact app name as shown by the apps tool, for example \"TextEdit\" or \"Google Chrome\"."
          },
          "into": {
            "type": "string",
            "description": "The control: its id from outline, such as \"e3\", or plain words, such as \"the note body\"."
          }
        },
        "required": [
          "app",
          "into"
        ]
      }
    },
    {
      "name": "set_value",
      "description": "Set a control to a value directly: choose an option in a popup or dropdown by its text, or set a slider, stepper, date or plain text field. Reads the value back.",
      "inputSchema": {
        "type": "object",
        "properties": {
