          }
        },
        "required": [
          "app",
          "into",
          "value"
        ]
      }
    },
    {
      "name": "pointer",
      "description": "Mouse gestures on a control by its [id] (or plain words): double_click (open a file or folder in Finder), right_click (context menu), or drag onto another control given as to (move a file into a folder). Needs headed mode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "app": {
