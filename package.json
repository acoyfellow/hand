{
  "name": "hand",
  "version": "0.1.0",
  "private": true,
  "description": "Clef steers computer use. Code lists what can be clicked, Clef picks with a probability, code acts, Clef checks.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test test/ bench/",
    "check": "bun run typecheck && bun run lint && bun run test",
    "lab": "bun lab/build.ts",
    "screens": "bun bench/screens.ts",
    "probe": "bun bench/probe.ts",
    "t1": "bun bench/t1-grounding.ts",
    "t2": "bun bench/report.ts",
    "t3": "bun bench/t3-verify.ts",
    "t4": "bun bench/t4-e2e.ts",
    "t5": "bun bench/t5-safety.ts",
    "evals": "bun bench/run-all.ts",
    "report": "bun bench/report.ts",
    "smoke": "bun bench/smoke.ts",
    "bench": "HAND_REPEATS=${HAND_REPEATS:-3} HAND_ARMS=${HAND_ARMS:-vision:kimi-k2.6,vision:qwen3.8-27b,baton:kimi-k2.6,pilot} HAND_SKIP_CACHE=${HAND_SKIP_CACHE:-1} bun bench/run-all.ts",
    "bench:mock": "HAND_MOCK=1 HAND_RUN=${HAND_RUN:-check} HAND_SCREENS=2 HAND_PER_SCREEN=2 HAND_T3_PER_SCREEN=1 HAND_TASKS=mail-archive HAND_REPEATS=2 HAND_ARMS=vision:kimi-k2.6,vision:qwen3.8-27b,baton:kimi-k2.6,pilot bun bench/run-all.ts && python3 bench/compare-runs.py reference-mock check-mock",
    "bench:verify": "bun bench/verify.ts",
    "gate": "bun bench/gate.ts",
    "bench:mock:reference": "HAND_MOCK=1 HAND_RUN=reference HAND_SCREENS=2 HAND_PER_SCREEN=2 HAND_T3_PER_SCREEN=1 HAND_TASKS=mail-archive HAND_REPEATS=2 HAND_ARMS=vision:kimi-k2.6,vision:qwen3.8-27b,baton:kimi-k2.6,pilot bun bench/run-all.ts",
    "writers": "bun bench/writer-eval.ts",
    "site:install": "cd site && bun install",
    "site:dev": "cd site && bun run dev",
    "site:build": "cd site && bun run build",
    "site:a11y": "cd site && bun run a11y",
    "site:shots": "cd site && bun run shots",
    "site:deploy": "cd site && bun run deploy",
    "brand": "cd site && bun run brand"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@browserbasehq/stagehand": "^4.3.0",
    "@playwright/mcp": "^0.0.84",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "agent-browser": "0.41.1",
    "agent-desktop": "1.0.2",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./clef": "./src/clef.ts",
    "./clairic": "./src/clairic.ts",
    "./hand": "./src/hand.ts",
    "./steer": "./src/steer.ts",
    "./cursor.js": "./src/cursor.js",
    "./perceive": "./src/perceive.ts",
    "./llm": "./src/llm.ts",
    "./anthropic": "./src/anthropic.ts",
    "./credentials": "./src/credentials.ts",
    "./writer": "./src/writer.ts",
    "./devices/macos": "./src/devices/macos.ts",
    "./devices/browser": "./src/devices/browser.ts",
    "./mcp": "./src/mcp.ts",
    "./helper": "./src/helper.ts"
  },
  "bin": {
    "hand": "./src/cli.ts"
  },
  "files": [
    "src",
    "native/ax.swift",
    "README.md",
    "LICENSE",
    "llms.txt"
  ]
}
